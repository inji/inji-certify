{
	"vcTemplate": {
    "issuer": "${_issuer}",
    "validFrom": "${validFrom}",
    "validUntil": "${validUntil}",
    "credentialSubject": {
      "id": "${_holderId}",
      "{{credential_key1}}": "{{credential_value1}}",
      "{{credential_key2}}": "{{credential_value2}}",
      "{{credential_key3}}": "{{credential_value3}}",
      "{{credential_key4}}": "{{credential_value4}}",
      "{{credential_key5}}": "{{credential_value5}}"
  }},
    "credentialFormat": "{{credentialFormat}}",
    "credentialConfigKeyId": "{{credentialConfigKeyId}}",    
    "didUrl": "{{didUrl}}",        
    "keyManagerAppId" : "{{keyManagerAppId}}",
    "keyManagerRefId" : "{{keyManagerRefId}}",
    "signatureAlgo" : "{{signatureAlgo}}",
    {{#if cryptographicBindingMethodsSupported}}
    "cryptographicBindingMethodsSupported": [{{#each cryptographicBindingMethodsSupported}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}],
    {{/if}}
    {{#if proofTypeName}}
    "proofTypesSupported": {"{{proofTypeName}}": {"proof_signing_alg_values_supported": [{{#each proofSigningAlgValuesSupported}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}]}},
    {{/if}}
    {{#if sdClaim}}"sdClaim": "{{sdClaim}}",{{/if}}
    "displayOrder" : [
	      {{#each displayOrder}}
	            "{{displayOrder_values}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],
    "scope" : "{{scope}}",
    "sdJwtVct" : "{{sdJwtVct}}",    
    "metaDataDisplay" : [{
    "name": "{{display_name}}",
    "locale": "en",
    "logo": {
      "uri": "https://inji.github.io/inji-config/logos/agro-vertias-logo.png",
      "alt_text": "land statement Logo"
    },
    "background_color": "#ebfaff",
    "background_image": {"uri": "https://inji.github.io/inji-config/logos/agro-vertias-logo.png"},    
    "text_color": "#000000"
  }],
    "sdJwtClaims" : {
        "RegistrationDate": {
            "display": [
                {
                    "name": "Registration Date",
                    "locale": "en"
                }
            ]
        },
        "iss": {
            "display": [
                {
                    "name": "Iss",
                    "locale": "en"
                }
            ]
        },
        "exp": {
            "display": [
                {
                    "name": "Exp",
                    "locale": "en"
                }
            ]
        },
        "cnf": {
            "display": [
                {
                    "name": "Cnf",
                    "locale": "en"
                }
            ]
        },
        "nbf": {
            "display": [
                {
                    "name": "Nbf",
                    "locale": "en"
                }
            ]
        }
    }
}
