{
	"vcTemplate": {
  "nameSpaces": {
    {{#each nameSpaces}}
    "{{namespace}}": [
      {{#each elements}}
      {
        "digestID": {{digestID}},
        "elementIdentifier": "{{elementIdentifier}}",
        "elementValue": {{#if isString}}"{{elementValue}}"{{else}}"RAW:{{elementValue}}"{{/if}}
      }{{#unless @last}},{{/unless}}
      {{/each}}
    ]{{#unless @last}},{{/unless}}
    {{/each}}
  },
  "docType": "${_doctype}",
  "validityInfo": {
    "validFrom": "${_validFrom}",
    "signed": "${_signed}",
    "validUntil": "${_validUntil}"
  }
},
"credentialFormat": "{{credentialFormat}}",
"credentialConfigKeyId": "{{credentialConfigKeyId}}",
"didUrl": "{{didUrl}}",
"keyManagerAppId": "{{keyManagerAppId}}",
"keyManagerRefId": "{{keyManagerRefId}}",
"signatureAlgo": "{{signatureAlgo}}",
"doctype": "{{doctype}}",
{{#if cryptographicBindingMethodsSupported}}
"cryptographicBindingMethodsSupported": [{{#each cryptographicBindingMethodsSupported}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}],
{{/if}}
{{#if proofTypeName}}
"proofTypesSupported": {"{{proofTypeName}}": {"proof_signing_alg_values_supported": [{{#each proofSigningAlgValuesSupported}}"{{this}}"{{#unless @last}},{{/unless}}{{/each}}]}},
{{/if}}
"displayOrder": [{{#each displayOrder}}"{{displayOrder_values}}"{{#unless @last}},{{/unless}}{{/each}}],
"scope": "{{scope}}",
    "metaDataDisplay" : [{
    "name": "{{display_name}}",
    "locale": "en",
    "logo": {
      "uri": "https://inji.github.io/inji-config/logos/mosipid-logo.png",
      "alt_text": "a square logo of a MOSIP"
    },
    "background_color": "#12107c",
    "background_image": {
            "uri": "https://inji.github.io/inji-config/vcbackground/default-background.png"
          },
    "text_color": "#FFFFFF"
  }],
"msoMdocClaims": {
  {{#each msoMdocClaims}}
  "{{namespace}}": {
    {{#each claims}}
    "{{claim_name}}": {
      "display": [
        {{#each display}}
        {
          "name": "{{display_name}}",
          "locale": "{{display_locale}}"
        }{{#unless @last}},{{/unless}}
        {{/each}}
      ]
    }{{#unless @last}},{{/unless}}
    {{/each}}
  }{{#unless @last}},{{/unless}}
  {{/each}}
}
}
