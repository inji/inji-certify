{
	"configurationId": "{{configurationId}}",
	"vcTemplate": {
    "@context": ["https://www.w3.org/ns/credentials/v2", "https://api.released.mosip.net/.well-known/mosip-ida-context.json"],
    "issuer": "${_issuer}",
    "type": ["VerifiableCredential", "Mock_dataIntegrity_renderMethod_2.0"],
    "validFrom": "${validFrom}",
    "validUntil": "${validUntil}",
    "credentialSubject": {
      "id": "${_holderId}",
      "gender": "RAW:${gender}",
      "postalCode": "RAW:${postalCode}",
      "fullName": "RAW:${fullName}",
      "dateOfBirth": "${dateOfBirth}",
      "phone": "${phone}",
      "province": "RAW:${province}",
      "region": "RAW:${region}",
      "UIN": "RAW:${UIN}",
      "VID": "RAW:${UIN}",
      "email": "${email}"
  },
    "renderMethod": [{
      "type": "TemplateRenderMethod",
      "renderSuite": "svg-mustache",
      "template": {
        "digestMultibase": "${_renderMethodSVGdigest}",
        "id": "{{renderMethodId}}",
        "mediaType": "image/svg+xml"
      }
    }]
  },
    "contextURLs": [
	      {{#each contextURLs}}
	            "{{contextURLs}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],
	"credentialTypes": [
	      {{#each credentialTypes}}
	            "{{credentialTypes}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],
    "credentialFormat": "{{credentialFormat}}",
    "credentialConfigKeyId": "{{credentialConfigKeyId}}",
    "didUrl": "{{didUrl}}",
    "keyManagerAppId" : "{{keyManagerAppId}}",
    "keyManagerRefId" : "{{keyManagerRefId}}",
    "signatureAlgo" : "{{signatureAlgo}}",
    "signatureCryptoSuite" : "{{signatureCryptoSuite}}",
    "displayOrder" : [
	      {{#each displayOrder}}
	            "{{displayOrder_values}}"
	          {{#unless @last}},{{/unless}}
	      	{{/each}}
        ],
    "scope" : "{{scope}}",
    "metaDataDisplay" : [{
    "name": "{{display_name}}",
    "locale": "en",
    "logo": {
      "uri": "https://inji.github.io/inji-config/logos/mosipid-logo.png",
      "alt_text": "a square logo of a MOSIP"
    },
    "background_color": "#12107c",
    "text_color": "#FFFFFF"
  }],
    "claims" : {
    "fullName": {
        "display": [
            {
                "name": "Full Name",
                "locale": "en"
            }
        ]
    },
    "phone": {
        "display": [
            {
                "name": "Phone Number",
                "locale": "en"
            }
        ]
    },
    "dateOfBirth": {
        "display": [
            {
                "name": "Date of Birth",
                "locale": "en"
            }
        ]
    },
    "gender": {
        "display": [
            {
                "name": "Gender",
                "locale": "en"
            }
        ]
    },
    "email": {
        "display": [
            {
                "name": "Email Id",
                "locale": "en"
            }
        ]
    },
    "region": {
        "display": [
            {
                "name": "Region",
                "locale": "en"
            }
        ]
    },
    "addressLine1": {
        "display": [
            {
                "name": "Address Line 1",
                "locale": "en"
            }
        ]
    },
    "UIN": {
        "display": [
            {
                "name": "UIN",
                "locale": "en"
            }
        ]
    },
    "vcVer": {
        "display": [
            {
                "name": "VC Verification",
                "locale": "en"
            }
        ]
    },
    "postalCode": {
        "display": [
            {
                "name": "Postal Code",
                "locale": "en"
            }
        ]
    }
  },
    "cryptographicBindingMethodsSupported": ["jwk"],
    "proofTypesSupported": {"jwt": {"proof_signing_alg_values_supported": ["RS256", "ES256", "EdDSA"]}}
}
